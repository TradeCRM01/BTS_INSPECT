# Copy to .env for local dev. Production builds bake these from .env.production.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Live trial host: https://bts-inspect.pages.dev
# Supabase Auth Site URL + redirects must match that origin (see supabase/config.toml [auth]).

# Xero (Accounting settings) — set as Supabase edge-function secrets, never VITE_:
# XERO_CLIENT_ID
# XERO_CLIENT_SECRET
# optional: XERO_REDIRECT_URI (must be {origin}/settings/accounting)
# optional: XERO_TOKEN_KEY (encrypts the refresh token inside accounting_settings.settings)
