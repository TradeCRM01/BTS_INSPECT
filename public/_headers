# Always revalidate HTML so deploys don't leave clients on stale chunk maps
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed assets are immutable. The /assets product page is listed below without /*.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

